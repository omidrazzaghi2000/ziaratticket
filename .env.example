POSTGRES_DB=karvan
POSTGRES_USER=karvan
POSTGRES_PASSWORD=change_me_strong_password
DJANGO_SECRET_KEY=change_me_very_long_random_secret_key
ALLOWED_HOSTS=ziaratticket.ir,www.ziaratticket.ir
CERTBOT_EMAIL=your@email.com

# ربات بله — اطلاع رزرو به مدیر کاروان (توکن از @BotFather بله)
BALE_BOT_TOKEN=
# شناسه چت پشتیبانی، برای کاروان‌هایی که مدیرشان شناسه بله ندارد (اختیاری)
BALE_FALLBACK_CHAT_ID=
# نام کاربری ربات، فقط برای لینک «رفتن به ربات» در داشبورد مدیر کاروان
BALE_BOT_USERNAME=
# رمز مسیر وب‌هوک — یک رشته تصادفی بلند (مثلاً «openssl rand -hex 24»).
# با آن مدیر کاروان خودش حسابش را به ربات وصل می‌کند؛ پس از پرکردن، یک‌بار:
#   docker compose exec backend python manage.py bale_chat_ids --set-webhook https://ziaratticket.ir
BALE_WEBHOOK_SECRET=
